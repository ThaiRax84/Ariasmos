<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Ariasmos</AssemblyName>
    <RootNamespace>Ariasmos</RootNamespace>
    <AssemblyTitle>Ariasmos</AssemblyTitle>
    <Description>Ariasmos</Description>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>..\..\instalacion\ariasmos.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateResourceUsePreserializedResources>false</GenerateResourceUsePreserializedResources>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nucleo\Ariasmos.Nucleo.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\sistema\estaticos\marca\escena-vasija.jpg" LogicalName="Ariasmos.escena-vasija.jpg" />
    <EmbeddedResource Include="Recursos\fuentes\cinzel-latin-700-normal.ttf" LogicalName="Ariasmos.cinzel.ttf" />
    <EmbeddedResource Include="Recursos\fuentes\nunito-latin-400-normal.ttf" LogicalName="Ariasmos.nunito.ttf" />
    <None Include="Recursos\fuentes\LICENCIA-cinzel.txt" CopyToOutputDirectory="PreserveNewest" Link="licencias\LICENCIA-cinzel.txt" />
    <None Include="Recursos\fuentes\LICENCIA-nunito.txt" CopyToOutputDirectory="PreserveNewest" Link="licencias\LICENCIA-nunito.txt" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
