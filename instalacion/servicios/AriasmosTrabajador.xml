<service>
  <id>AriasmosTrabajador</id>
  <name>Ariasmos Trabajador</name>
  <description>Tareas periódicas de Ariasmos: cargos, recargos, cortes, entregas, respaldos y verificación de la bitácora.</description>
  <executable>%BASE%\..\python\python.exe</executable>
  <arguments>-X utf8 -B "%BASE%\..\app\sistema\manage.py" trabajador</arguments>
  <workingdirectory>%BASE%\..\app\sistema</workingdirectory>
  <env name="COBRO_INSTANCIA" value="%ProgramData%\Ariasmos\instancia"/>
  <env name="PYTHONUTF8" value="1"/>
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalService</user>
  </serviceaccount>
  <startmode>Automatic</startmode>
  <delayedAutoStart/>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>30 sec</stoptimeout>
  <logpath>%ProgramData%\Ariasmos\registros</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>5120</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
