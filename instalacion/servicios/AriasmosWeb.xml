<service>
  <id>AriasmosWeb</id>
  <name>Ariasmos Web</name>
  <description>Aplicación web de Ariasmos. Escucha solo en 127.0.0.1:8000; la red la atiende AriasmosTLS.</description>
  <executable>%BASE%\..\python\python.exe</executable>
  <arguments>-X utf8 -B "%BASE%\..\app\sistema\manage.py" servir --host 127.0.0.1 --puerto 8000</arguments>
  <workingdirectory>%BASE%\..\app\sistema</workingdirectory>
  <env name="COBRO_INSTANCIA" value="%ProgramData%\Ariasmos\instancia"/>
  <env name="PYTHONUTF8" value="1"/>
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalService</user>
  </serviceaccount>
  <startmode>Automatic</startmode>
  <delayedAutoStart/>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>30 sec</stoptimeout>
  <logpath>%ProgramData%\Ariasmos\registros</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>5120</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
